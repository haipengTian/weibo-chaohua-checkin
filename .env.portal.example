# 复制为 .env.portal，仅在服务器或本机填写，不要提交真实密码。
PANEL_USER=avatar
PANEL_PASSWORD=
# 已发布版本；服务器使用 pull / up --no-build，无需本地构建。
PORTAL_IMAGE=ghcr.io/haipengtian/weibo-chaohua-checkin:portal-v0.1.7
# Nginx 经 Docker 网关连接时，填写实际网关 IP；不要盲目信任任意来源。
FORWARDED_ALLOW_IPS=127.0.0.1

# 可选（旧版兼容回退）：推荐直接在管理端「系统设置 -> 麦麦集成」配置只读密钥与授权账号。
# 若管理端尚未保存配置，则会回退读取以下两项环境变量。
MAIBOT_READ_TOKEN=
MAIBOT_ACCOUNT_UIDS=
